{
  "project": "Explainable Deep Learning System for Chest X-Ray Classification Using Grad-CAM",
  "author": "Ameeras Oza",
  "advisor": "Dr. Rakesh Mahto",
  "institution": "California State University, Fullerton",
  "program": "M.S. Computer Engineering",
  "semester": "Fall 2025",
  "architecture": {
    "backbone": "ResNet-50",
    "pretrained_weights": "ImageNet V2",
    "classifier_head": [
      "Dropout(p=0.4)",
      "Linear(2048, 256)",
      "ReLU",
      "Dropout(p=0.3)",
      "Linear(256, 2)"
    ],
    "num_classes": 2,
    "classes": ["NORMAL", "PNEUMONIA"],
    "grad_cam_layer": "layer4"
  },
  "training": {
    "dataset": "Kaggle Chest X-Ray Images (Pneumonia)",
    "dataset_url": "https://www.kaggle.com/datasets/paultimothymooney/chest-xray-pneumonia",
    "train_images": 5216,
    "val_images": 16,
    "test_images": 624,
    "img_size": 224,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225],
    "batch_size": 32,
    "phase1_epochs": 5,
    "phase1_lr": 0.001,
    "phase2_max_epochs": 10,
    "phase2_lr_head": 0.001,
    "phase2_lr_backbone": 0.0001,
    "optimizer": "Adam",
    "loss": "CrossEntropyLoss",
    "scheduler": "CosineAnnealingLR",
    "early_stopping_patience": 4,
    "hardware": "NVIDIA Tesla T4 GPU (Google Colab)"
  },
  "results": {
    "test_accuracy": 0.9006,
    "test_accuracy_pct": "90.1%",
    "roc_auc": 0.9614,
    "weighted_f1": 0.90,
    "confusion_matrix": {
      "TN": 216,
      "FP": 18,
      "FN": 44,
      "TP": 346
    },
    "per_class": {
      "NORMAL": {
        "precision": 0.83,
        "recall": 0.92,
        "f1": 0.87,
        "support": 234
      },
      "PNEUMONIA": {
        "precision": 0.95,
        "recall": 0.887,
        "f1": 0.92,
        "support": 390
      }
    },
    "weighted_avg": {
      "precision": 0.91,
      "recall": 0.90,
      "f1": 0.90,
      "support": 624
    }
  },
  
  "files": {
    "best_model": "best_model.pth",
    "scripted_model": "model_scripted.pt",
    "notebook": "pulmonary_disease_detection.ipynb"
  }
}
